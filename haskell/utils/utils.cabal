cabal-version:      3.0
name:               utils
version:            0.1.0.0
license:            BSD-3-Clause
author:             George Thomas
maintainer:         georgefsthomas@gmail.com

library
    exposed-modules:
        Util
        Util.Lifx
        Util.Servant.Curl
        Util.Servant.Streamly
    hs-source-dirs: src
    default-language: GHC2021
    default-extensions:
        BlockArguments
        DataKinds
        DeriveAnyClass
        DerivingStrategies
        DuplicateRecordFields
        GADTs
        LambdaCase
        ImpredicativeTypes
        NoFieldSelectors
        NoMonomorphismRestriction
        OverloadedLabels
        OverloadedRecordDot
        OverloadedStrings
        PartialTypeSignatures
        RecordWildCards
        TypeAbstractions
        TypeData
        ViewPatterns
    build-depends:
        base >= 4.16,
        georgefst-utils,
        georgefst-utils:gpio-utils,
        georgefst-utils:streamly-utils,
        georgefst-utils:streamly-gpio,
        aeson ^>= {2.1.1, 2.2},
        async >= 2.2.4,
        binary >= 0.8.9,
        bytestring >= 0.10.12,
        containers >= 0.6,
        directory >= 1.2,
        exceptions >= 0.10,
        evdev >= 2.3,
        extra >= 1.7.10,
        freer-simple >= 1.2.1.2,
        http-api-data >= 0.6,
        http-types >= 0.12.3,
        lifx-lan >= 0.9,
        logging-effect >= 1.3.13,
        monad-loops >= 0.4.3,
        mtl >= 2.2.2,
        network >= 3.1.2,
        optics >= 0.4.2,
        optics-extra >= 0.4.2,
        optparse-generic >= 1.4.6,
        pretty-simple >= 4.1,
        rawfilepath >= 1.0,
        servant >= 0.20,
        servant-client >= 0.20,
        servant-foreign >= 0.16,
        servant-server >= 0.20,
        spotify:spotify >= 0.1,
        spotify:spotify-servant >= 0.1,
        spotify:spotify-types >= 0.1,
        streamly >= 0.10,
        streamly-core >= 0.1,
        text >= 1.2.4,
        time >= 1.9.3,
        wai >= 3.2,
        warp >= 3.3.28,
    ghc-options:
        -Wall
