cabal-version:      3.0
name:               sol
version:            0.1.0.0
license:            BSD-3-Clause
author:             George Thomas
maintainer:         georgefsthomas@gmail.com
extra-source-files:
    static/index.html
    static/index.js
    static/style.css

common common
    build-depends:
        aeson >= 2,
        base >= 4.16,
        bytestring >= 0.11,
        colour >= 2.3.6,
        containers >= 0.6,
        extra >= 1.7.10,
        http-api-data >= 0.6,
        http-types >= 0.12,
        monad-loops >= 0.4.3,
        mtl >= 2.3,
        optics >= 0.4.2,
        optics-extra >= 0.4.2,
        pretty-simple >= 4.1,
        servant >= 0.20,
        text >= 2.0,
        time >= 1.12,
        transformers >= 0.6,
    default-language: GHC2021
    default-extensions:
        BlockArguments
        DataKinds
        DeriveAnyClass
        DerivingStrategies
        DuplicateRecordFields
        GADTs
        ImpredicativeTypes
        LambdaCase
        NoFieldSelectors
        NoMonomorphismRestriction
        OverloadedLabels
        OverloadedRecordDot
        OverloadedStrings
        PartialTypeSignatures
        RecordWildCards
        TypeOperators
        ViewPatterns
    ghc-options:
        -Wall

common no-wasm
    if os(wasi)
        buildable: False

library sol-http-api
    import: common
    hs-source-dirs: api
    exposed-modules:
        API

executable sol
    import: common, no-wasm
    main-is: Main.hs
    hs-source-dirs: app
    other-modules:
        Evdev.Stream
        George.Core
        George.Feed.Keyboard
        George.Feed.WebServer
    build-depends:
        sol-http-api,
        utils,
        georgefst-utils,
        georgefst-utils:gpio-utils,
        georgefst-utils:streamly-utils,
        aeson-optics >= 1.2.1,
        async >= 2.2.4,
        binary >= 0.8.9,
        directory >= 1.3,
        evdev >= 2.3,
        exceptions >= 0.10,
        filepath-bytestring >= 1.4.2,
        freer-simple >= 1.2.1.2,
        hinotify >= 0.4.1,
        http-client >= 0.7.11,
        http-types >= 0.12.3,
        lifx-lan >= 0.8.0,
        logging-effect >= 1.4,
        network >= 3.1.2,
        optparse-applicative >= 0.19,
        optparse-generic >= 1.5,
        os-string >= 2.0,
        rawfilepath >= 1.1,
        servant-client >= 0.20,
        servant-foreign >= 0.16,
        servant-server >= 0.20,
        spotify:spotify >= 0.1,
        spotify:spotify-servant >= 0.1,
        spotify:spotify-types >= 0.1,
        streamly >= 0.10,
        streamly-core >= 0.2,
        streams >= 3.3.2,
        unix >= 2.8,
        wai >= 3.2,
        wai-app-static >= 3.1,
        warp >= 3.3.28,
    ghc-options:
        -threaded

executable sol-mock-server
    import: common, no-wasm
    main-is: Main.hs
    hs-source-dirs: mock
    build-depends:
        sol-http-api,
        servant-server,
        stm,
        wai,
        wai-cors,
        warp,
    ghc-options:
        -threaded

executable sol-web
    import: common
    main-is: Main.hs
    hs-source-dirs: web
    other-modules:
        Sol.API
    build-depends:
        sol-http-api,
        jsaddle,
        jsaddle-wasm,
        miso >= 1.12,
        servant-client-js,
    if os(wasi)
        ghc-options:
            -no-hs-main -optl-mexec-model=reactor
